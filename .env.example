# ==============================================================================
# APEXFIN AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env dan masukkan API Key Anda (semuanya memiliki Free Tier)
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# 1. Groq Cloud API (Free Tier: 30 RPM, ~300 tokens/sec)
# Dapatkan gratis di: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# 2. Google Gemini API (Free Tier: 15 RPM, high context)
# Dapatkan gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# 3. Vector Database (Qdrant)
# Gunakan Qdrant Cloud Free Tier (1GB free cluster) atau jalankan in-memory lokal
# Dapatkan gratis di: https://cloud.qdrant.io/
QDRANT_URL=:memory:
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=financial_documents

# 4. Observability & Tracing (Optional - Langfuse Free Cloud)
# Dapatkan gratis di: https://cloud.langfuse.com/
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=false

# 5. Security & Guardrails
PROMPT_CANARY_SECRET=apexfin-canary-audit-token-998
MAX_FILE_SIZE_MB=25
MAX_RETRIEVAL_CANDIDATES=25
TOP_RERANK_LIMIT=5
